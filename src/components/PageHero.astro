---
import Photo from './Photo.astro';
import photos from '../data/photos.json';

interface Props {
  title: string;
  intro?: string;
  photo: keyof typeof photos;
  focal?: string;
}

const { title, intro, photo, focal } = Astro.props;
---

<section class="page-hero on-photo">
  <Photo slug={photo} eager sizes="100vw" class="ph-img" focal={focal} />
  <div class="ph-scrim" aria-hidden="true"></div>
  <div class="wrap ph-inner">
    <h1 class="display h-xl rise">{title}</h1>
    {intro && <p class="ph-intro rise rise-2">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: clamp(360px, 52vw, 560px);
    display: grid;
    align-items: end;
    color: #f3f5f8;
    background: var(--navy-950);
    overflow: hidden;
  }
  .page-hero :global(.ph-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--scrim) / 0.9) 0%, rgb(var(--scrim) / 0.45) 45%, rgb(var(--scrim) / 0.15) 100%),
      linear-gradient(to right, rgb(var(--scrim) / 0.45) 0%, rgb(var(--scrim) / 0) 60%);
  }
  .ph-inner {
    position: relative;
    padding-block: 96px clamp(36px, 5vw, 60px);
  }
  .ph-intro {
    margin-top: 18px;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: rgb(243 245 248 / 0.88);
  }
</style>
