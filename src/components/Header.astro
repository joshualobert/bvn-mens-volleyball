---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { team } from '../data/team';
import { url } from '../lib/site';

interface Props {
  path: string;
  overlay?: boolean;
}

const { path, overlay = true } = Astro.props;
const nav = [
  { href: '/schedule/', label: 'Schedule' },
  { href: '/roster/', label: 'Roster' },
  { href: '/program/', label: 'Program' },
  { href: '/media/', label: 'Media' },
];
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <Wordmark />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={team.youtube} rel="noopener" target="_blank" class="ext">
            Film <Icon name="arrowUpRight" size={14} />
            <span class="sr-only">(opens YouTube in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>

    <a class="ig" href={team.instagram} rel="noopener" target="_blank">
      <Icon name="instagram" size={18} />
      <span class="ig-text">{team.instagramHandle}</span>
      <span class="sr-only">(opens Instagram in a new tab)</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="open"><Icon name="list" size={22} /></span>
      <span class="close"><Icon name="x" size={22} /></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="wrap">
      <li><a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      {
        nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={team.youtube} rel="noopener" target="_blank">
          Film <Icon name="arrowUpRight" size={22} />
        </a>
      </li>
      <li>
        <a href={team.instagram} rel="noopener" target="_blank" class="mobile-ig">
          <Icon name="instagram" size={20} />
          {team.instagramHandle}
        </a>
      </li>
    </ul>
  </div>
</header>
<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');

  // Solid header once the top of the page (the hero) scrolls away.
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel) {
    new IntersectionObserver(([e]) => header.classList.toggle('is-solid', !e.isIntersecting), {
      rootMargin: '0px 0px 0px 0px',
    }).observe(sentinel);
  }

  if (btn && menu && header) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('no-scroll', open);
    };
    btn.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(5 11 24 / 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  /* Over a hero photo: transparent until scrolled */
  .site-header.overlay {
    margin-bottom: calc(-1 * var(--header-h));
  }
  .site-header.overlay:not(.is-solid):not(.menu-open) {
    background: linear-gradient(to bottom, rgb(4 10 23 / 0.7), rgb(4 10 23 / 0));
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 70vh;
    pointer-events: none;
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .brand {
    text-decoration: none;
    margin-right: auto;
  }
  .nav ul {
    display: flex;
    gap: 2px;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: var(--header-h);
    padding: 0 14px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    position: relative;
    transition: color 0.2s var(--ease);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav .ext :global(.icon) {
    color: var(--accent);
  }
  .ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink-2);
    padding: 8px 12px;
    border: 1px solid var(--line-strong);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .ig:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .menu-btn {
    display: none;
    background: rgb(5 11 24 / 0.4);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    width: 42px;
    height: 42px;
    place-items: center;
    cursor: pointer;
  }
  .menu-btn .close,
  .menu-btn[aria-expanded='true'] .open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .close {
    display: block;
  }
  .mobile-menu {
    border-top: 1px solid var(--line);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }
  .mobile-menu ul {
    padding-block: 12px 40px;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-stretch: 70%;
    font-weight: 800;
    font-size: 2.125rem;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
  }
  .mobile-menu a :global(.icon) {
    color: var(--accent);
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu .mobile-ig {
    font-family: var(--mono);
    font-stretch: 100%;
    font-weight: 500;
    font-size: 0.875rem;
    text-transform: none;
    border-bottom: 0;
    padding-top: 28px;
    color: var(--ink-2);
  }
  @media (max-width: 1099px) {
    .ig-text {
      display: none;
    }
  }
  @media (max-width: 959px) {
    .nav,
    .ig {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  :global(html.no-scroll) {
    overflow: hidden;
  }
</style>
