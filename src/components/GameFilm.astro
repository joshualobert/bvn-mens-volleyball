---
import Icon from './Icon.astro';
import { team, gameFilm } from '../data/team';

interface Props {
  /** How many videos to show after the featured one (keep it a multiple of 3). */
  count?: number;
}

const { count = 6 } = Astro.props;
const [featured, ...rest] = gameFilm;
const grid = rest.slice(0, count);
const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="film">
  <div class="featured">
    <button type="button" class="yt yt-lg" data-id={featured.id} aria-label={`Play ${featured.title}`}>
      <img src={thumb(featured.id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
      <span class="play" aria-hidden="true"><Icon name="play" size={34} /></span>
    </button>
    <div class="featured-meta">
      <h3 class="display h-md">{featured.title}</h3>
      <p class="lede">BVN against KC East in the first state semifinal at Horejsi Arena, May 5, 2026.</p>
      <p class="len">Full match, {featured.length}</p>
    </div>
  </div>

  <ul class="grid">
    {
      grid.map((v) => (
        <li>
          <button type="button" class="yt" data-id={v.id} aria-label={`Play ${v.title}`}>
            <img src={thumb(v.id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
            <span class="play" aria-hidden="true">
              <Icon name="play" size={26} />
            </span>
          </button>
          <span class="v-title">{v.title}</span>
          <span class="len">{v.length}</span>
        </li>
      ))
    }
  </ul>

  <a class="arrow-link" href={team.youtubeVideos} rel="noopener" target="_blank">
    All game film on YouTube <Icon name="arrowUpRight" size={18} />
  </a>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
      frame.title = btn.getAttribute('aria-label')?.replace(/^Play /, '') ?? 'Game film';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'yt-frame';
      btn.replaceWith(frame);
      frame.focus();
    });
  });
</script>

<style>
  .film {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    justify-items: start;
  }
  .featured {
    width: 100%;
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: end;
  }
  .featured-meta {
    display: grid;
    gap: 10px;
    padding-bottom: 8px;
  }
  .yt,
  .film :global(.yt-frame) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: var(--navy-950);
    cursor: pointer;
    overflow: hidden;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease), opacity 0.3s var(--ease);
    opacity: 0.88;
  }
  .yt:hover img {
    transform: scale(1.02);
    opacity: 1;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    background: rgb(6 16 36 / 0.82);
    border: 1.5px solid rgb(243 245 248 / 0.7);
    color: #f3f5f8;
    transition: background-color 0.2s var(--ease);
  }
  .yt-lg .play {
    width: 84px;
    height: 84px;
  }
  .yt:hover .play {
    background: var(--accent-bright);
  }
  .grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 16px;
  }
  .grid li {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .grid li > :first-child {
    margin-bottom: 6px;
  }
  .v-title {
    font-weight: 650;
  }
  .len {
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 559px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
