---
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', size]}>
  <span class="mark">BVN</span>
  <span class="words">
    <span class="w1">Men's Volleyball</span>
    <span class="w2">Blue Valley North</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    line-height: 1;
  }
  .mark {
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--navy-950);
    font-stretch: 70%;
    font-weight: 850;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    padding: 7px 8px 6px;
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .words {
    display: grid;
    gap: 4px;
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
  }
  .w1 {
    font-stretch: 75%;
    font-weight: 750;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .w2 {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lg .mark {
    font-size: 2rem;
    padding: 9px 12px 8px;
  }
  .lg .w1 {
    font-size: 1.25rem;
  }
  .lg .w2 {
    font-size: 0.6875rem;
  }
</style>
