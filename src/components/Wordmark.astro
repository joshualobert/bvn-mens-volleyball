---
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', size]}>
  <span class="mark">BVN</span>
  <span class="words">
    <span>Men's</span>
    <span>Volleyball</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: stretch;
    gap: 10px;
    line-height: 1;
  }
  .mark {
    display: grid;
    place-items: center;
    background: var(--brand-block);
    color: var(--on-brand);
    font-stretch: 72%;
    font-weight: 880;
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    padding: 6px 8px 5px;
  }
  .words {
    display: grid;
    align-content: center;
    gap: 2px;
    font-stretch: 80%;
    font-weight: 750;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lg .mark {
    font-size: 2.25rem;
    padding: 8px 12px 7px;
  }
  .lg .words {
    font-size: 1.0625rem;
    gap: 4px;
  }
</style>
