---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { roster, positionNames, type Position } from '../data/team';

const total = roster.groups.reduce((n, g) => n + g.players.length, 0);
const rows = roster.groups.flatMap((g) => g.players.map((p) => ({ ...p, group: g })));
const fullPositions = (ps?: Position[]) => ps?.map((p) => positionNames[p]).join(' / ') ?? '';
---

<Base
  title="2026 Roster"
  description="The 2026 Blue Valley North Men's Volleyball roster: varsity, JV and varsity floaters with positions for BVN Boys Volleyball."
  path="/roster/"
>
  <PageHero
    title={`${roster.season} Roster`}
    intro={`${total} players across varsity and junior varsity, as announced by the team for the ${roster.season} season.`}
    photo="medal-ceremony"
    focal="50% 38%"
    kicker="Team"
  />

  <section class="section" aria-labelledby="roster-title">
    <div class="wrap">
      <div class="toolbar" data-reveal>
        <h2 id="roster-title" class="display h-md">Players</h2>
        <div class="tabs" role="tablist" aria-label="Filter roster">
          <button type="button" role="tab" aria-selected="true" data-filter="all">
            All <span class="n">{total}</span>
          </button>
          {
            roster.groups.map((g) => (
              <button type="button" role="tab" aria-selected="false" data-filter={g.id}>
                {g.title} <span class="n">{g.players.length}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="table" data-reveal>
        <div class="thead mono" aria-hidden="true">
          <span>Player</span>
          <span>Position</span>
          <span>Team</span>
        </div>
        <ul class="tbody">
          {
            rows.map((p) => (
              <li data-group={p.group.id}>
                <span class="name display">{p.name}</span>
                <span class="pos">
                  {p.positions ? (
                    <>
                      <span class="code mono">{p.positions.join('/')}</span>
                      <span class="full">{fullPositions(p.positions)}</span>
                    </>
                  ) : (
                    <span class="full muted">Not listed</span>
                  )}
                </span>
                <span class:list={['chip', { 'chip-accent': p.group.id === 'varsity' }]}>{p.group.title}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="key" data-reveal>
        <span class="label">Positions</span>
        <dl>
          {
            (Object.keys(positionNames) as Position[]).map((k) => (
              <div>
                <dt class="mono">{k}</dt>
                <dd>{positionNames[k]}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <figure class="band" data-reveal>
    <Photo slug="arms-around-huddle" sizes="100vw" class="photo-fill" focal="50% 40%" />
  </figure>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('.tbody li');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const f = tab.dataset.filter;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.group !== f));
    }),
  );
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--line-strong);
  }
  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .tabs button + button {
    border-left: 1px solid var(--line-strong);
  }
  .tabs button:hover {
    color: var(--ink);
  }
  .tabs button[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .n {
    opacity: 0.65;
  }
  .thead,
  .tbody li {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.2fr) 160px;
    gap: 24px;
    align-items: center;
  }
  .thead {
    padding: 0 20px 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .tbody li {
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s var(--ease);
  }
  .tbody li:hover {
    background: var(--surface);
  }
  .tbody li[hidden] {
    display: none;
  }
  .name {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1;
  }
  .pos {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-width: 0;
  }
  .code {
    color: var(--accent);
    min-width: 52px;
  }
  .full {
    color: var(--ink-2);
  }
  .muted {
    color: var(--muted);
  }
  .tbody .chip {
    justify-self: start;
  }
  .key {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 28px;
  }
  .key dl {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .key dl div {
    display: flex;
    gap: 8px;
    font-size: 0.9375rem;
  }
  .key dt {
    color: var(--accent);
  }
  .key dd {
    color: var(--ink-2);
  }
  .band {
    height: clamp(280px, 40vw, 560px);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 767px) {
    .thead {
      display: none;
    }
    .tbody li {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name team' 'pos pos';
      gap: 8px 12px;
      padding: 16px 4px;
    }
    .name {
      grid-area: name;
    }
    .pos {
      grid-area: pos;
    }
    .tbody .chip {
      grid-area: team;
      justify-self: end;
    }
    .tabs {
      width: 100%;
    }
    .tabs button {
      flex: 1 1 auto;
      justify-content: center;
      padding: 11px 10px;
    }
  }
</style>
