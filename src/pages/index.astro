---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { team, roster, varsitySchedule, postseason, seasons, positionNames } from '../data/team';
import { url, dateParts } from '../lib/site';

const varsity = roster.groups.find((g) => g.id === 'varsity')!;
const season = seasons.find((s) => s.year === 2026 && s.level === 'Varsity')!;
---

<Base
  title="Blue Valley North Men's Volleyball | BVN Boys Volleyball, Overland Park, KS"
  description="Blue Valley North Men's Volleyball (BVN Boys Volleyball) from Overland Park, Kansas. Third place at the 2026 state championship. Roster, schedule, results and photos."
  path="/"
>
  <section class="hero on-photo" aria-labelledby="hero-title">
    <Photo slug="attack-over-the-block" eager sizes="100vw" class="hero-img" focal="30% 35%" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="display rise">
        <span class="h1-school">Blue Valley North</span>
        <span class="h1-sport">Men's Volleyball</span>
      </h1>
      <p class="hero-sub rise rise-2">
        Mustangs boys volleyball from Overland Park, Kansas. Third place at the 2026 state championship.
      </p>
      <div class="hero-ctas rise rise-3">
        <a class="btn btn-primary" href={url('/schedule/')}>2026 Results <Icon name="arrowRight" size={18} /></a>
        <a class="btn btn-secondary" href={team.instagram} rel="noopener" target="_blank">
          <Icon name="instagram" size={18} /> Instagram
        </a>
      </div>
    </div>
  </section>

  <section class="scoreboard" aria-labelledby="season-title">
    <div class="wrap">
      <h2 id="season-title" class="label">2026 varsity season</h2>
      <dl class="stats">
        <div>
          <dt>Match record</dt>
          <dd class="display">{season.wins}-{season.losses}</dd>
        </div>
        <div>
          <dt>Sets won and lost</dt>
          <dd class="display">{season.setWins}-{season.setLosses}</dd>
        </div>
        <div>
          <dt>State championship</dt>
          <dd class="display">3rd</dd>
        </div>
        <div>
          <dt>League final ranking</dt>
          <dd class="display">5th<span class="of"> of {season.teams}</span></dd>
        </div>
      </dl>
      <p class="source">
        Records from the <a class="text-link" href={team.league.standings} rel="noopener" target="_blank"
          >{team.league.name} final standings</a
        >.
      </p>
    </div>
  </section>

  <section class="section state" aria-labelledby="state-title">
    <div class="wrap state-grid">
      <figure class="state-main">
        <Photo slug="state-tournament-huddle" sizes="(min-width: 900px) 58vw, 100vw" class="photo-fill" />
      </figure>
      <div class="state-copy">
        <h2 id="state-title" class="display h-lg">Final Four at Horejsi</h2>
        <p class="lede">
          BVN went 4-0 on state tournament day to reach the Final Four, met KC East in the first semifinal at Horejsi
          Arena, and finished third in the state.
        </p>
        <ol class="timeline">
          {
            postseason.map((step) => {
              const d = dateParts(step.date);
              return (
                <li>
                  <span class="t-date">
                    {d.month} {d.day}
                  </span>
                  <span class="t-body">
                    <strong>{step.title}</strong>
                    {step.detail}
                  </span>
                </li>
              );
            })
          }
        </ol>
      </div>
      <figure class="state-side">
        <Photo slug="state-tournament-attack" sizes="(min-width: 900px) 30vw, 100vw" class="photo-fill" />
      </figure>
      <figure class="state-side-2">
        <Photo slug="state-tournament-high-fives" sizes="(min-width: 900px) 28vw, 100vw" class="photo-fill" />
      </figure>
    </div>
  </section>

  <section class="section roster" aria-labelledby="roster-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="roster-title" class="display h-lg">2026 Varsity</h2>
      </div>
      <ul class="names">
        {
          varsity.players.map((p) => (
            <li>
              <span class="name display">{p.name}</span>
              <span class="pos">{p.positions?.map((x) => positionNames[x]).join(' / ')}</span>
            </li>
          ))
        }
      </ul>
      <a class="arrow-link" href={url('/roster/')}>Full roster <Icon name="arrowRight" size={18} /></a>
    </div>
  </section>

  <section class="section schedule" aria-labelledby="schedule-title">
    <div class="wrap schedule-grid">
      <div class="schedule-head">
        <h2 id="schedule-title" class="display h-lg">2026 Schedule</h2>
        <p class="prose">
          Six regular season match days, each against two opponents, followed by the state tournament on May 2 and the
          Final Four on May 5. The 2027 schedule will be posted here and on Instagram once it is released.
        </p>
        <a class="arrow-link" href={url('/schedule/')}>Schedule and results <Icon name="arrowRight" size={18} /></a>
      </div>
      <ol class="days">
        {
          varsitySchedule.map((m) => {
            const d = dateParts(m.date);
            return (
              <li>
                <span class="d-date">
                  <span class="d-mon">{d.month}</span>
                  <span class="d-day display">{d.day}</span>
                </span>
                <span class="d-opp">
                  {m.opponents.map((o) => (
                    <span>{o}</span>
                  ))}
                </span>
                <span class:list={['d-site', m.site.toLowerCase()]}>{m.site}</span>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="mosaic" aria-label="Photos from the 2026 season">
    <div class="mosaic-grid">
      <Photo slug="huddle-hands-raised" sizes="(min-width: 900px) 50vw, 100vw" class="photo-fill m1" />
      <Photo slug="attack-number-21" sizes="(min-width: 900px) 25vw, 50vw" class="photo-fill m2" />
      <Photo slug="jersey-number-15" sizes="(min-width: 900px) 25vw, 50vw" class="photo-fill m3" />
      <Photo slug="timeout-with-coach" sizes="(min-width: 900px) 25vw, 50vw" class="photo-fill m4" />
    </div>
    <div class="wrap mosaic-foot">
      <a class="arrow-link" href={url('/media/')}>Photo gallery <Icon name="arrowRight" size={18} /></a>
    </div>
  </section>

  <section class="section follow" aria-labelledby="follow-title">
    <div class="wrap follow-grid">
      <div>
        <h2 id="follow-title" class="display h-lg">Follow the Mustangs</h2>
        <p class="lede">
          Match days, results and photos go up first on the team Instagram. Prospective players and families can reach
          the team there too.
        </p>
        <a class="btn btn-primary" href={team.instagram} rel="noopener" target="_blank">
          <Icon name="instagram" size={18} />
          {team.instagramHandle}
        </a>
      </div>
      <figure class="follow-photo">
        <Photo slug="bench-applause" sizes="(min-width: 900px) 34vw, 100vw" class="photo-fill" />
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(calc(100dvh - var(--header-h)), 900px);
    display: grid;
    align-items: end;
    color: #f3f5f8;
    background: var(--navy-950);
    overflow: hidden;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--scrim) / 0.9) 0%, rgb(var(--scrim) / 0.5) 34%, rgb(var(--scrim) / 0.12) 62%),
      linear-gradient(to left, rgb(var(--scrim) / 0.78) 0%, rgb(var(--scrim) / 0.35) 45%, rgb(var(--scrim) / 0) 62%);
  }
  .hero-inner {
    position: relative;
    padding-block: 120px clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
  .hero-inner > * {
    grid-column: 7 / -1;
  }
  .hero h1 {
    display: grid;
    gap: 14px;
  }
  .h1-school {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-stretch: 85%;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--accent-bright);
  }
  .h1-sport {
    font-size: clamp(3.25rem, 7.4vw, 7rem);
    max-width: 9ch;
  }
  .hero-sub {
    margin-top: 20px;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: rgb(243 245 248 / 0.88);
  }
  .hero-ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Scoreboard */
  .scoreboard {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(36px, 5vw, 56px);
  }
  .stats {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stats > div {
    padding: 4px 24px;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column-reverse;
    gap: 10px;
  }
  .stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stats dt {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .stats dd {
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    color: var(--ink);
  }
  .stats .of {
    font-size: 0.42em;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .source {
    margin-top: 24px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* State run */
  .state-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: clamp(16px, 2vw, 28px);
  }
  .state-main {
    grid-column: 1 / span 7;
    grid-row: 1;
    aspect-ratio: 4 / 3;
  }
  .state-copy {
    grid-column: 9 / span 4;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: start;
    padding-top: 8px;
  }
  .state-side {
    grid-column: 1 / span 4;
    grid-row: 2;
    aspect-ratio: 3 / 2;
  }
  .state-side-2 {
    grid-column: 5 / span 3;
    grid-row: 2;
    aspect-ratio: 1 / 1;
  }
  .timeline {
    border-top: 1px solid var(--line-strong);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .t-date {
    font-weight: 750;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 2px;
  }
  .t-body {
    display: grid;
    gap: 2px;
    color: var(--ink-2);
    font-size: 0.9875rem;
  }
  .t-body strong {
    color: var(--ink);
    font-weight: 750;
  }

  /* Roster */
  .roster {
    background: var(--surface);
  }
  .names {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
    margin-bottom: 40px;
  }
  .names li {
    padding: 22px 24px 22px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 6px;
  }
  .name {
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1;
  }
  .pos {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Schedule */
  .schedule-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .schedule-head {
    display: grid;
    gap: 24px;
    justify-items: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .days {
    border-top: 1px solid var(--line-strong);
  }
  .days li {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .d-date {
    display: grid;
    line-height: 1;
    gap: 4px;
  }
  .d-mon {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .d-day {
    font-size: 2.5rem;
  }
  .d-opp {
    display: grid;
    gap: 2px;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .d-opp span::before {
    content: 'vs ';
    font-weight: 400;
    color: var(--muted);
  }
  .d-site {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .d-site.home {
    background: var(--brand-block);
    border-color: var(--brand-block);
    color: var(--on-brand);
  }

  /* Mosaic */
  .mosaic {
    border-top: 1px solid var(--line);
  }
  .mosaic-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 4px;
    height: clamp(420px, 56vw, 760px);
  }
  .mosaic-grid :global(.m1) {
    grid-row: 1 / span 2;
  }
  .mosaic-grid :global(.m2) {
    grid-row: 1 / span 2;
  }
  .mosaic-foot {
    padding-block: 28px;
    display: flex;
    justify-content: flex-end;
  }

  /* Follow */
  .follow-grid {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .follow-grid > div {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .follow-photo {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 899px) {
    .stats {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .stats > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .state-grid {
      grid-template-columns: 1fr 1fr;
    }
    .state-main {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .state-copy {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .state-side,
    .state-side-2 {
      grid-row: auto;
      grid-column: span 1;
      aspect-ratio: 1 / 1;
    }
    .names {
      grid-template-columns: 1fr 1fr;
    }
    .schedule-grid,
    .follow-grid {
      grid-template-columns: 1fr;
    }
    .schedule-head {
      position: static;
    }
    .mosaic-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      height: auto;
    }
    .mosaic-grid :global(.m1) {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 3 / 2;
    }
    .mosaic-grid :global(.m2) {
      grid-row: span 2;
    }
    .mosaic-grid :global(.m3),
    .mosaic-grid :global(.m4) {
      aspect-ratio: 1 / 1;
    }
  }
  @media (max-width: 899px) {
    .hero-inner > * {
      grid-column: 1 / -1;
    }
    .hero-scrim {
      background: linear-gradient(to top, rgb(var(--scrim) / 0.94) 0%, rgb(var(--scrim) / 0.6) 40%, rgb(var(--scrim) / 0) 70%);
    }
  }
  @media (max-width: 559px) {
    .hero-inner {
      padding-top: 96px;
    }
    .names {
      grid-template-columns: 1fr;
    }
    .names li {
      padding: 18px 0;
    }
    .hero-ctas .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
    .days li {
      grid-template-columns: 56px 1fr auto;
      gap: 14px;
    }
    .d-day {
      font-size: 2rem;
    }
    .d-opp {
      font-size: 0.9875rem;
    }
  }
</style>
