---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { team } from '../data/team';
import { absolute, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/roster/". Used for the canonical URL. */
  path: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, path, image = '/og-image.jpg', noindex = false } = Astro.props;
const canonical = absolute(path);
const ogImage = absolute(image);
const fullTitle = path === '/' ? title : `${title} | ${team.name}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: team.name,
  alternateName: ['BVN Boys Volleyball', 'Blue Valley North Boys Volleyball', 'BVN Mustangs Volleyball'],
  sport: 'Volleyball',
  url: absolute('/'),
  logo: absolute('/icon-512.png'),
  image: ogImage,
  sameAs: [team.instagram],
  location: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'Overland Park', addressRegion: 'KS', addressCountry: 'US' },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}

    {team.googleSiteVerification && <meta name="google-site-verification" content={team.googleSiteVerification} />}
    <meta name="theme-color" content="#0a1a36" />
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <link rel="icon" href={url("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={team.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A BVN attacker swings over a double block at the net" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
